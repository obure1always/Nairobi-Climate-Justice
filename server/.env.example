# Climate Justice Nairobi - Server Environment Configuration Reference
# IMPORTANT: Copy this file to .env and configure values. Do NOT commit production secrets to Git.

# -------------------------------------------------------------
# 1. Server Core Configuration
# -------------------------------------------------------------
PORT=3001
NODE_ENV=production

# Allowed CORS Origin for production (e.g., https://climatejusticenairobi.org)
# If left empty, defaults to allowing standard local and same-origin requests.
ALLOWED_ORIGIN=https://climatejusticenairobi.org

# -------------------------------------------------------------
# 2. Database Persistence
# -------------------------------------------------------------
# Local SQLite path. On Render use /var/data/database.sqlite on the persistent disk.
SQLITE_DB_PATH=./database.sqlite

# Alternatively, for enterprise PostgreSQL deployments:
# DATABASE_URL=postgresql://user:password@localhost:5432/climate_justice_nairobi

# -------------------------------------------------------------
# 3. Staff Access
# -------------------------------------------------------------

# Only used when creating the first administrator in an empty database.
# Choose a unique password with at least 14 characters; never commit real values.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# -------------------------------------------------------------
# 4. Authentication Architecture (Zero External Cost)
# -------------------------------------------------------------
# Phone-number-and-password and email-and-password authentication
# are fully self-contained and run on the backend using Node's native
# scrypt cryptographic hashing. No third-party SMS providers 
# (Twilio or Africa's Talking) are required to register or sign in.

# -------------------------------------------------------------
# 5. Google OAuth 2.0 (Optional)
# -------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=

# -------------------------------------------------------------
# 6. AI Curriculum Tutor & Neural Audio (Optional)
# -------------------------------------------------------------
# GroqCloud Free Developer Tier API Key for Climate Buddy (https://console.groq.com/keys)
# If empty, runs in deterministic local offline curriculum mode.
GROQ_API_KEY=

# Cloud Neural Voice (OpenAI TTS or ElevenLabs)
# If empty, runs client-side natural speech synthesis.
OPENAI_API_KEY=
OPENAI_TTS_VOICE=nova

# -------------------------------------------------------------
# 7. Certificate signature and email delivery
# -------------------------------------------------------------
# Set the approved PNG/JPEG path in production, outside the public client
# directory. On Render, place it privately at /var/data/certificate-signature.png.
CERTIFICATE_SIGNATURE_PATH=

# Certificate emails use Resend. Only accounts with verified email addresses
# are eligible; missing provider settings mark delivery failed but do not
# disable certificate downloads.
CERTIFICATE_EMAIL_PROVIDER=resend
RESEND_API_KEY=
CERTIFICATE_FROM_EMAIL=
