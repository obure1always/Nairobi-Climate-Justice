# Climate Justice Nairobi Server Environment Configuration

# Server Port
PORT=3001

# Administration Secret Key for Research Dataset Export
# Set a strong randomized secret before deploying to production
ADMIN_EXPORT_SECRET=your_admin_secret_key_here

# GroqCloud Free Developer Tier API Key (Zero Cost)
# Get a free key at: https://console.groq.com/keys
# The free tier requires no payment method and provides no-cost inference for llama-3.1-8b-instant.
# If left empty, Climate Buddy automatically runs in local offline curriculum mode.
GROQ_API_KEY=
