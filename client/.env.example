# Climate Justice Nairobi - Client Environment Configuration Reference
# IMPORTANT: Copy this file to .env.local for local overrides. Do NOT commit production secrets.

# -------------------------------------------------------------
# 1. API Endpoint Configuration
# -------------------------------------------------------------
# In standard production deployments, the frontend SPA and backend API are served
# behind an Nginx/Caddy reverse proxy where requests to /api are automatically forwarded
# to the backend service (port 3001).
# If hosting the frontend on an isolated static CDN separate from the API domain:
# VITE_API_BASE_URL=https://api.climatejusticenairobi.org

# -------------------------------------------------------------
# 2. Third-Party Authenticators (Optional)
# -------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Web Client ID for Google One-Tap & Sign-In
# Obtain from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
